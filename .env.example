# =============================================================================
# Invictus Pharma — production env (Docker Compose on the live server)
# =============================================================================
# Copy this file to `.env` on the server (same folder as docker-compose.yml).
#
# Fill ONLY the PUT_YOUR_* lines. Keys below are already generated for this
# project — keep AUTH_SECRET identical in backend/.env if you use that file.
#
# Database is the MySQL/MariaDB already on the live host (not a Docker DB).
# From inside Docker, the host is host.docker.internal
# =============================================================================

NODE_ENV=production
PUBLIC_SITE_URL=https://invictuspharma.net
NEXT_PUBLIC_SITE_URL=https://invictuspharma.net
NEXT_PUBLIC_SITE_NAME=Invictus Pharma
IMAGE_ORIGIN=https://greatlifepharma.com

# Next.js (server) talks to Django on the compose network
DJANGO_API_URL=http://backend:8000

# Same value Django uses to sign login tokens — do not change after go-live
# unless you are ready to log everyone out.
AUTH_SECRET=crQaEBqsfFmOfX2GIYNCSXXR0av5R_uVJ3jSCPh0gnn91RH4Eh1gO752_XwrXTP6o5H7r-JnVcU_shDy-g_tpA

DJANGO_SECRET_KEY=29R93MsMnIOnLY7AYqK0dInMzRhUoqXNrEYer3VBRjxttuh0q6z1YyeGJipmNX6r16dztCqCRgeWx1H042JDIA
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=invictuspharma.net,www.invictuspharma.net,PUT_YOUR_SERVER_IP,127.0.0.1,localhost
DJANGO_ADMIN_PATH=django-admin
CORS_ALLOWED_ORIGINS=https://invictuspharma.net,https://www.invictuspharma.net

# 0 until HTTPS works; set to 1 after certbot / nginx.docker.ssl.conf
COOKIE_SECURE=0

# --- Host MySQL/MariaDB (NOT a Docker database) ---
# Shop always writes to this machine (master). Slave is backup/failover only.
#
# Socket path used by the backend container (Ubuntu/Debian):
MYSQL_DATABASE=invictuspharma
MYSQL_USER=invictus
MYSQL_PASSWORD=PUT_YOUR_MYSQL_PASSWORD
MYSQL_HOST=/run/mysqld/mysqld.sock
MYSQL_PORT=3306
#
# Fallback if you cannot mount the socket (TCP to the host):
# MYSQL_HOST=host.docker.internal
#
# Replication user password lives in MySQL, not in the app:
# PUT_YOUR_REPL_PASSWORD

# SMTP is configured in the admin CMS after first login (/admin/cms/email).
# Leave mail passwords out of this file.
